function updateViz(dt){if(!vizReady)return;const stage=S.reg;const ff=Math.max(0,Math.min(1,S.f/S.fMax));const hasF=stage>=1&&stage<=6&&ff>.01;const apexX=rebuildCandles(stage,ff);const isPulse=stage===1||stage===2;const showSph=hasF&&stage>=1&&stage<=6;vizOuterSphere.visible=showSph;if(showSph&&stage>=3){vizInnerLocus.visible=true;vizInnerLocus.material.emissiveIntensity=4;vizOuterSphere.material.emissiveIntensity=1.5;vizOuterSphere.material.opacity=.65;}else if(showSph){vizInnerLocus.visible=true;vizOuterSphere.material.emissiveIntensity=.5;vizOuterSphere.material.opacity=0;}else{vizInnerLocus.visible=false;vizOuterSphere.material.emissiveIntensity=0;}const beamActive=(S.on&&!S.targetReached&&S.reg!==7&&(S.f>0||S.reg>=6)&&S.v>0);if(beamActive){vizBeamParticles.forEach(bp=>{bp.mesh.visible=true;if(stage!==6&&stage!==8){const len=hasF?apexX:8;bp.phase=(bp.phase+dt*14/Math.abs(len||1))%1;bp.mesh.position.x=bp.phase*(hasF?apexX:8);bp.mesh.material.emissiveIntensity=1;bp.mesh.scale.setScalar(1);}else{bp.distance+=dt*bp.speed;if(bp.distance>35)bp.distance=0;bp.mesh.position.x=S.isBraking?bp.distance:-bp.distance;bp.mesh.material.emissiveIntensity=Math.max(0,1-bp.distance/35);bp.mesh.scale.setScalar(Math.max(.1,.9*(1-bp.distance/35)));}});}else vizBeamParticles.forEach(bp=>bp.mesh.visible=false);const ismVis=(stage>=2&&stage<=6)||stage===8;vizFunnel.visible=ismVis;if(S.isBraking)vizFunnel.material.color.setHex(0xff4444);else vizFunnel.material.color.setHex(0x8b5cf6);vizIsmParticles.forEach(p=>{p.mesh.visible=ismVis;if(!ismVis)return;const sp=(.9+(7.2-.9)*(1-p.x/funnelMouth))*p.sf;p.x-=sp*dt;if(p.x<=0){p.x=funnelMouth;const mr=funnelR;const r=Math.sqrt(Math.random())*mr;const a=Math.random()*PI*2;p.nr=r/mr;p.a=a;p.sf=.7+Math.random()*.9;}const mr=funnelR*(p.x/funnelMouth);const r=p.nr*mr;p.mesh.position.set(p.x,Co(p.a)*r,Si(p.a)*r);const pr=1-(p.x/funnelMouth);const ion=Math.pow(pr,1.2);const bC=new THREE.Color(0x66ccff),iC=new THREE.Color(S.isBraking?0xff6644:0xffffff);p