let vizLastTs=0;function vizLoop(now){requestAnimationFrame(vizLoop);if(!vizReady)return;let dt=Math.min(.033,(now-vizLastTs)/1000);vizLastTs=now;vizAnimTime+=dt;updateViz(dt);}

// =================================================================
// MAIN LOOP
// =================================================================
let lastTimestamp=0;
const WARP_MAP={0:0.001,1:0.01,2:0.1,3:1,4:10,5:3600,6:86400,7:604800,8:2592000,9:31536000};
const CRUISE_MAX_STEP=604800, BRAKE_MAX_STEP=3600, BOOTSTRAP_MAX_DT=10.0;

function loop(nowMs){
    requestAnimationFrame(loop);
    if(!S.on||S.targetReached){lastTimestamp=0;return;}
    if(lastTimestamp===0){lastTimestamp=nowMs;return;}
    let dt_real=Math.min(.1,(nowMs-lastTimestamp)/1000);lastTimestamp=nowMs;
    let warp = Number(el('inWarp').value);  // Number() handles 0 correctly unlike parseInt()||3
    let dt_pf=WARP_MAP[warp]||1;
    updateWarpLabel(warp);
    let rem=dt_pf;
    while(rem>0){
        let isBoot=(S.reg<=3&&S.f>.1&&!S.ltdRetired);
        let mx = isBoot ? BOOTSTRAP_MAX_DT : S.isBraking ? BRAKE_MAX_STEP : CRUISE_MAX_STEP;
        let step=Math.min(mx,rem);
        physicsStep(step);
        rem-=step;
    }
}

