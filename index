    <div class="panel" style="border-color:#1e3a5f;">
        <h3 style="font-size:0.85rem; margin:0 0 8px 0; color:#ef4444;">🔄 MHD Field Reversal Braking — Physics</h3>
        <div class="model-summary">
            <p>Deceleration uses <strong>magnetic field geometry modulation</strong> (cymatics-like reshaping), not physical rotation. The ship orientation never changes. The funnel's magnetic topology reverses to redirect captured medium <strong>forward</strong> instead of aft.</p>

            <h4>Momentum Transfer (Relativistic)</h4>
            <ul>
                <li>Medium (ISM or stellar wind) enters funnel at ship velocity: <span class="eq">p_in = ṁ·γ_ship·v_ship</span></li>
                <li>Field redirects medium forward at <span class="eq">v_exit</span>: <span class="eq">p_out = ṁ·γ_out·v_exit</span></li>
                <li><strong>Braking force:</strong> <span class="eq">F_brake = ṁ·(γ_in·v_in + γ_out·v_out)</span></li>
                <li>This is <strong>~2×</strong> the force of simply catching the ISM (inelastic capture gives only <span class="eq">F = ṁ·γ·v</span>), because the redirected momentum <em>adds</em> to the captured momentum.</li>
            </ul>

            <h4>With TE/Kilopower Energy Addition</h4>
            <ul>
                <li>Energy per unit mass of redirected medium: <span class="eq">(γ_out − 1)c² = (γ_in − 1)c² + P_avail/ṁ</span></li>
                <li>So: <span class="eq">γ_out = γ_in + P_avail/(ṁ·c²)</span>, and <span class="eq">v_out = c·√(1 − 1/γ_out²)</span></li>
                <li>Adding energy increases <span class="eq">v_out > v_in</span>, amplifying the braking force beyond passive reflection.</li>
            </ul>

            <h4>Stellar Wind Enhancement</h4>
            <ul>
                <li>ISM density: <span class="eq">ρ_ISM ≈ 2×10⁻²³</span> kg/m³ (Local Bubble)</li>
                <li>Stellar wind at 1 AU from target: <span class="eq">ρ_wind ≈ 8×10⁻²¹</span> kg/m³ (Sun-like) — <strong>400× denser</strong></li>
                <li>Wind density scales as <span class="eq">1/r²</span>: <span class="eq">ρ(r) = ρ_1AU / r²</span></li>
                <li>Astrosphere boundary: ~500 AU from star. Inside this, stellar wind dominates ISM.</li>
                <li>At 10 AU: <span class="eq">ρ ≈ 8×10⁻²³</span> (8× ISM). At 1 AU: <span class="eq">ρ ≈ 8×10⁻²¹</span> (400× ISM). At 0.1 AU: <span class="eq">ρ ≈ 8×10⁻¹⁹</span> (40,000× ISM).</li>
                <li>Braking effectiveness increases <strong>dramatically</strong> on final approach.</li>
            </ul>

            <div class="limitation-box">
                <h4 style="margin:0 0 6px 0; color:#f97316;">⚠️ Braking Simplifications</h4>
                <ul>
                    <li>Stellar wind assumed radially symmetric and steady-state.</li>
                    <li>Braking trigger is heuristic (estimated stopping distance ≤ remaining distance).</li>
                    <li>No trajectory optimisation — constant braking once engaged.</li>
                    <li>Magnetic field efficiency for momentum reversal assumed 100%.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
// =================================================================
// CONSTANTS
// =================================================================
const C=299792458.0, SEC_YR=31536000.0, LY_TO_M=9.461e15, AU_TO_M=1.495978707e11;
const T_AMB=293.0, T_MAX=1500.0, DRY_MASS=30000, A_CATCH=1000.0, RHO_ISM=2e-23;
const H_SUB=850000.0, ALPHA=0.12, ETA_JET=0.88, ETA_CPL=0.52;
const N_VEINS=720000, K_NANO=0.05, V_ACC_MAX=15.0, P_LIA_BACKUP=20000.0;
const SIGMA_SB=5.670374e-8, EPS_RAD=0.99, A_RAD=125.0;
const LIH_PER_PULSE=3.3e-18, LASER_DEGRADE_PER_JOULE=1e-16, LIH_INIT=1e-6;
const KILO_RATED_POWER=10000.0, KILO_DEGRADE_START_YR=15.0, LTD_CYCLES_TOTAL=1e6;
const V_FF=0.04*C, GAM_FF=1/Math.sqrt(1-0.04**2);
const V_FUS=0.10*C, GAM_FUS=1/Math.sqrt(1-0.10**2);
const V_PION=0.99*C, GAM_PION=1/Math.sqrt(1-0.99**2);
const V_ABL=V_FF;

// Stellar wind: density at 1 AU from Sun-like star
const RHO_WIND_1AU=8e-21;  // kg/m³
const ASTROSPHERE_AU=500;  // stellar wind dominates inside this radius

// =================================================================
// STATE (distance in metres, all energy accumulators in Earth frame)
// =================================================================
let S={
    on:false, targetReached:false, transmitted:false,
    t:0, tEarth:0, v:0, d:0, f:15000, fMax:15000,
    lih:LIH_INIT, laserHealth:1.0,
    kiloLife:50.0, kiloMax:50.0, kiloEfficiency:1.0,
    ltdCycles:LTD_CYCLES_TOTAL, ltdRetired:false,
    tB:293, reg:1, ablMu:1.0,
    targetAU:268000,
    // MHD braking state
    isBraking:false, ltdBraking:false, brakeForce:0, brakeRho:RHO_ISM, brakeMdot:0,
    brakeGamIn:1, brakeGamOut:1, brakeDistRemain:0, brakeAreaMult:1.0,
    // Energy accumulators (all Earth-frame coordinate time)
    eBeam:0, eNuc:0, eExh:0, eTherm:0, eRad:0,
    hist:{t:[],v:[],e:[]}
};

const el=id=>document.getElementById(id);
const setT=(id,v)=>{if(el(id))el(id).textContent=v;};
const fmtP=w=>w>1e9?(w/1e9).toFixed(4)+' GW':w>1e6?(w/1e6).toFixed(4)+' MW':w>1e3?(w/1e3).toFixed(4)+' kW':w.toFixed(4)+' W';
const fmtN=n=>{if(n===0)return"0.000 N";if(n<0.001)return(n*1e6).toFixed(3)+" μN";if(n<1)return(n*1000).toFixed(3)+" mN";if(n<1000)return n.toFixed(3)+" N";return(n/1000).toFixed(3)+" kN";};
const fmtE=j=>j>1e18?(j/1e18).toFixed(4)+' EJ':j>1e15?(j/1e15).toFixed(4)+' PJ':j>1e12?(j/1e12).toFixed(4)+' TJ':j>1e9?(j/1e9).toFixed(4)+' GJ':j>1e6?(j/1e6).toFixed(4)+' MJ':j>1e3?(j/1e3).toFixed(4)+' kJ':j.toFixed(4)+' J';
function addLog(m){let d=el('logArea');if(d){d.innerHTML+=`<div>[${new Date().toLocaleTimeString()}] ${m}</div>`;d.scrollTop=d.scrollHeight;}}

function computeTE(T){const dT=Math.max(0,T-T_AMB);const eta_c=Math.max(0,1-T_AMB/T);const Q_total=dT*N_VEINS*K_NANO;return{P_elec:Q_total*eta_c,Q_total,eta_c};}
function computeVacc(P){return 1.0+(V_ACC_MAX-1.0)*Math.min(1.0,P/1.5e6);}
function computeECM(V_GV){const V_J=V_GV*1e9*1.602e-19;const mp_c2=0.938272e9*1.602e-19;return Math.sqrt(2*mp_c2*(2*mp_c2+V_J))/1.602e-10;}
function getKiloPower(){let u=S.kiloMax-S.kiloLife;if(u<=KILO_DEGRADE_START_YR)S.kiloEfficiency=1;else{S.kiloEfficiency=Math.max(0,1-(u-KILO_DEGRADE_START_YR)/(S.kiloMax-KILO_DEGRADE_START_YR));}return KILO_RATED_POWER*S.kiloEfficiency;}

const WARP_LABELS=['0.001×','0.01×','0.1×','1× (Real)','10×','1 hour','1 day','1 week','1 month','1 year'];
function updateWarpLabel(v){setT('outWarp',WARP_LABELS[v]||'1×');}

// =================================================================
// STELLAR WIND DENSITY MODEL
// =================================================================
function getLocalDensity(dist_from_target_m) {
    // Outside astrosphere: pure ISM
    const astro_m = ASTROSPHERE_AU * AU_TO_M;
    if (dist_from_target_m > astro_m || dist_from_target_m <= 0) return RHO_ISM;
    // Inside astrosphere: stellar wind ∝ 1/r², blended with ISM floor
    const r_au = dist_from_target_m / AU_TO_M;
    const rho_wind = RHO_WIND_1AU / (r_au * r_au);
    return Math.max(RHO_ISM, rho_wind);  // wind always ≥ ISM
}

// =================================================================
// MHD BRAKING FORCE (relativistic momentum reversal)
// =================================================================
function computeBrakingForce(v_ship, rho_local, P_available, A_eff) {
    if (v_ship < 100) return { force: 0, mdot: 0, gam_in: 1, gam_out: 1 };

    const beta = v_ship / C;
    const gam_in = 1 / Math.sqrt(1 - Math.min(0.999999, beta * beta));

    // Mass flow into effective capture area (relativistic)
    const mdot = A_eff * v_ship * rho_local * gam_in;

    // Exit Lorentz factor: incoming KE + added energy
    const E_add_per_kg = (mdot > 1e-30) ? P_available / mdot : 0;
    const gam_out = gam_in + E_add_per_kg / (C * C);
    const v_out = C * Math.sqrt(Math.max(0, 1 - 1 / (gam_out * gam_out)));

    // Braking force = ṁ(γ_in·v_in + γ_out·v_out)
    const force = mdot * (gam_in * v_ship + gam_out * v_out);

    return { force, mdot, gam_in, gam_out };
}

// =================================================================
// RK4 INTEGRATOR
// =================================================================
function rk4Accel(v_ms,F_N,m_kg){const b=Math.min(Math.abs(v_ms)/C,0.999999);const g=1/Math.sqrt(1-b*b);return F_N/(m_kg*Math.max(1,g*g*g));}
function rk4Step(v,F,M,dt){const k1=rk4Accel(v,F,M);const k2=rk4Accel(v+0.5*k1*dt,F,M);const k3=rk4Accel(v+0.5*k2*dt,F,M);const k4=rk4Accel(v+k3*dt,F,M);return v+(dt/6)*(k1+2*k2+2*k3+k4);}

// =================================================================
// PHYSICS STEP
// =================================================================
function physicsStep(dt){
    if(S.targetReached)return;
    const ablMu=parseFloat(el('inAbl').value)||1.0; S.ablMu=ablMu;
    const beta=S.v/C;
    const gamma=1/Math.sqrt(1-Math.min(0.999999,beta*beta));
    const dt_proper=dt/gamma;

    const{P_elec:P_te,Q_total:Q_TE_total}=computeTE(S.tB);
    let kiloPowerNow=(S.kiloLife>0)?getKiloPower():0;
    let P_bus=Math.max(P_te,kiloPowerNow);

    let regime=1;
    const P_te_kW=P_te/1000, P_beam_kW=P_te_kW*ETA_CPL;
    if(S.f<=0.1){regime=(S.kiloLife>0&&kiloPowerNow>100)?6:7;}
    else{if(S.v>=0.03*C)regime=5;else if(P_beam_kW>=1500)regime=4;else{const va=computeVacc(P_te);const ec=computeECM(va);if(ec>=3.75)regime=3;else if(P_te_kW>=10)regime=2;else regime=1;}}
    // Braking is an ADDITIVE force, not a regime override. Display reg 8 when active.
    S.reg = S.isBraking ? 8 : regime;

    // LTD
    let ltd_used=0;
    if(!S.ltdRetired&&regime>=1&&regime<=3){
        const hz=regime===1?2.0:regime===2?3.5:100.0;
        ltd_used=hz*dt_proper; S.ltdCycles=Math.max(0,S.ltdCycles-ltd_used);
        if(S.ltdCycles<=0){S.ltdRetired=true;S.ltdCycles=0;}
    }else if(regime>=4&&regime<=5&&!S.ltdRetired)S.ltdRetired=true;

    let P_beam=0;
    if(regime===1&&!S.ltdRetired){P_beam=79e3*Math.min(1,1e-3*1000)*ETA_CPL;}
    else if(regime===6){P_beam=Math.max(P_LIA_BACKUP,P_te)*ETA_CPL;}
    else if(regime<=5){P_beam=P_te*ETA_CPL;}

    let V_acc=0,ecm=0;
    if(regime<=5){V_acc=computeVacc(P_beam);ecm=computeECM(V_acc);}
    let fus_frac=0,had_frac=0;
    if(ecm>1.9)fus_frac=Math.min(0.9,(ecm-1.9)*0.5);
    if(ecm>=3.75)had_frac=Math.min(0.8,(ecm-3.75)*0.4);
    const Pi1=250*(1+10*fus_frac+1200*had_frac);
    let Q_tot=0,md_core=0,md_ff=0,md_fus=0,md_pion=0,md_abl=0,mdot_tot=0;
    let th_ff=0,th_fus=0,th_pion=0,th_abl=0,thrust=0;
    let lih_used=0,laser_deg=0;
    const needLiH=(regime<=4&&S.v<0.03*C);
    const canFire=(!needLiH)||(S.lih>0);

    // === FORWARD THRUST (regimes 1-5) ===
    if(regime<=5&&S.f>0&&canFire&&(regime!==1||S.ltdCycles>0||S.ltdRetired)){
        Q_tot=P_beam*Pi1;
        const eff=(1-ALPHA)*ETA_CPL;
        const q_ff=Q_tot/(1+10*fus_frac+1200*had_frac);
        const q_fus=q_ff*10*fus_frac, q_had=q_ff*1200*had_frac;
        md_ff=(q_ff*eff)/((GAM_FF-1)*C*C);
        md_fus=(q_fus*eff)/((GAM_FUS-1)*C*C);
        md_pion=(q_had*eff)/((GAM_PION-1)*C*C);
        md_core=md_ff+md_fus+md_pion;
        md_abl=md_core*ablMu;
        mdot_tot=md_core+md_abl;
        if(regime<=3){th_ff=md_ff*GAM_FF*V_FF;th_fus=md_fus*GAM_FUS*V_FUS;th_pion=md_pion*GAM_PION*V_PION;th_abl=md_abl*GAM_FF*V_ABL;thrust=th_ff+th_fus+th_pion+th_abl;}
        else{const gam_sys=1+Q_tot*ETA_JET/(mdot_tot*C*C);const v_sys=C*Math.sqrt(1-1/(gam_sys*gam_sys));thrust=mdot_tot*gam_sys*v_sys;th_ff=thrust*(md_ff/mdot_tot);th_fus=thrust*(md_fus/mdot_tot);th_pion=thrust*(md_pion/mdot_tot);th_abl=thrust*(md_abl/mdot_tot);}
        if(regime===5){const ism_mdot=A_CATCH*S.v*RHO_ISM;if(ism_mdot>0&&P_te>0){thrust+=ism_mdot*(Math.sqrt(S.v*S.v+2*P_te*0.5/ism_mdot)-S.v);}}
        if(needLiH&&S.lih>0){lih_used=(P_beam/1e4)*LIH_PER_PULSE*dt_proper;S.lih=Math.max(0,S.lih-lih_used);}
        // [FIX] No mass defect double-count. Fuel = exhaust mass only.
        // [FIX] Use dt (coordinate time) for fuel, consistent with RK4.
        S.f=Math.max(0,S.f-mdot_tot*dt);
        // [FIX] Energy accumulators: all in coordinate time (Earth frame)
        S.eBeam+=P_beam*dt; S.eNuc+=Q_tot*dt;
        S.eExh+=((GAM_FF-1)*md_ff+(GAM_FUS-1)*md_fus+(GAM_PION-1)*md_pion+(GAM_FF-1)*md_abl)*C*C*dt;
    }else if(regime===6 && !S.isBraking){
        // NEP forward thrust — only when NOT braking (ISM can't go both directions)
        const ism_mdot=A_CATCH*S.v*RHO_ISM;
        if(ism_mdot>0&&(kiloPowerNow>100||P_te>0)){
            const P_nep=Math.max(P_LIA_BACKUP,P_te);
            const v_ex=Math.sqrt(S.v*S.v+2*P_nep/ism_mdot);
            thrust=ism_mdot*(v_ex-S.v);if(thrust<0)thrust=0;
            mdot_tot=ism_mdot;
        }
    }

    // === MHD BRAKING — additive, with LTD pulsed magnetosphere inflation ===
    let brakeForce=0;
    const targetDist_m=S.targetAU*AU_TO_M;
    const remaining_m=Math.max(0,targetDist_m-S.d);
    S.brakeDistRemain=remaining_m;
    const remaining_au=remaining_m/AU_TO_M;

    // Star collision detection (~0.001 AU ≈ 150,000 km, safe distance for red dwarf)
    const STAR_MIN_AU = 0.001;
    if(S.isBraking && remaining_m > 0 && remaining_au < STAR_MIN_AU && S.v > 1000) {
        S.targetReached = true;
        addLog(`💥 STELLAR IMPACT: Ship entered star at ${(S.v/C*100).toFixed(4)}%c. Distance: ${(remaining_au*AU_TO_M/1000).toFixed(0)} km from centre.`);
        return;
    }

    // Auto-engage passive MHD braking at 5 AU
    const BRAKE_ENGAGE_AU = 5;
    if(!S.isBraking && !S.targetReached && S.v > 0.0001*C && S.targetAU > 10
        && remaining_m < BRAKE_ENGAGE_AU * AU_TO_M && remaining_m > 0) {
        S.isBraking = true;
        addLog(`🔄 MHD Field Reversal at ${(S.v/C*100).toFixed(4)}%c, ${remaining_au.toFixed(2)} AU from target. Passive stellar wind braking.`);
        const warpEl = el('inWarp');
        if(warpEl && Number(warpEl.value) > 4) {
            warpEl.value = 4;
            updateWarpLabel(4);
            addLog('⏩ Warp auto-reduced to 10×.');
        }
    }

    // Auto-engage LTD pulsed mode at 1 AU (stellar wind ≈ 400× ISM)
    // Saves LTD cycles for where they matter most
    const LTD_BRAKE_ENGAGE_AU = 1.0;
    if(S.isBraking && !S.ltdBraking && S.ltdCycles > 0 && remaining_au < LTD_BRAKE_ENGAGE_AU && remaining_au > STAR_MIN_AU) {
        S.ltdBraking = true;
        addLog(`⚡ LTD Pulsed Braking activated at ${remaining_au.toFixed(3)} AU. ${S.ltdCycles.toFixed(0)} cycles remaining. Magnetosphere inflation engaged.`);
    }

    // Compute braking force when active
    if(S.isBraking && S.v > 100 && remaining_m > STAR_MIN_AU * AU_TO_M) {
        const rho_local = getLocalDensity(remaining_m);
        S.brakeRho = rho_local;
        const P_avail = Math.max(P_LIA_BACKUP, P_te);

        // LTD pulsed magnetosphere inflation
        // Kilopower steady = 10 kW. LTD accumulates then discharges in ~1ms.
        // At pulse_freq Hz: E_pulse = P_kilo / freq, P_peak = E_pulse / 1ms
        // Effective area multiplier = (P_peak / P_steady)^(1/3) × bubble_persistence
        let A_eff = A_CATCH;
        let pulse_hz = 0;
        if(S.ltdBraking && S.ltdCycles > 0) {
            // Budget remaining cycles over estimated remaining braking time
            // At current v and remaining distance, time ≈ d/v (non-relativistic OK for braking)
            const est_brake_time = (S.v > 100) ? remaining_m / S.v : 86400;
            // Target: use all remaining cycles over remaining braking time
            // Clamp to 0.5-5 Hz range (below 0.5 Hz bubble collapses, above 5 Hz diminishing returns)
            pulse_hz = Math.max(0.5, Math.min(5.0, S.ltdCycles / Math.max(1, est_brake_time)));
            const P_steady = P_avail;
            const E_pulse = P_steady / pulse_hz;            // J per pulse
            const P_peak = E_pulse / 1e-3;                  // W peak (1ms discharge)
            // Magnetosphere standoff: R ∝ B^(1/3) ∝ P^(1/6), so A ∝ R² ∝ P^(1/3)
            const area_mult_raw = Math.pow(P_peak / Math.max(1, P_steady), 1.0/3.0);
            // Bubble persistence between pulses: ~80% at 2 Hz, scales with freq
            const bubble_persist = Math.min(0.95, 0.6 + 0.15 * pulse_hz);
            const area_mult = area_mult_raw * bubble_persist;
            A_eff = A_CATCH * Math.min(50, area_mult);  // cap at 50× (50,000 m²)
            S.brakeAreaMult = Math.min(50, area_mult);

            // Consume LTD cycles
            const cycles_used = pulse_hz * dt_proper;
            S.ltdCycles = Math.max(0, S.ltdCycles - cycles_used);
            if(S.ltdCycles <= 0) {
                S.ltdBraking = false;
                S.ltdCycles = 0;
                addLog('🔋 LTD cycles exhausted during braking. Reverting to passive MHD.');
            }
        } else {
            S.brakeAreaMult = 1.0;
        }

        const bk = computeBrakingForce(S.v, rho_local, P_avail, A_eff);
        brakeForce = bk.force;
        S.brakeForce = brakeForce;
        S.brakeMdot = bk.mdot;
        S.brakeGamIn = bk.gam_in;
        S.brakeGamOut = bk.gam_out;
        thrust -= brakeForce;
    }

    // Auto-warp cascade on approach
    if(remaining_m > 0 && S.targetAU > 10) {
        const warpEl = el('inWarp');
        if(S.isBraking && remaining_m < 0.0005 * AU_TO_M && warpEl && Number(warpEl.value) > 0) {
            warpEl.value = 0;
            updateWarpLabel(0);
        } else if(S.isBraking && remaining_m < 0.05 * AU_TO_M && warpEl && Number(warpEl.value) > 1) {
            warpEl.value = 1;
            updateWarpLabel(1);
        } else if(remaining_m < 1000 * AU_TO_M && warpEl && Number(warpEl.value) > 5) {
            warpEl.value = 5;
            updateWarpLabel(5);
            addLog('⏩ Warp auto-reduced to 1 hour (1000 AU from target).');
        }
    }

    // Laser degradation — always when P_beam > 0
    if(P_beam>0&&S.laserHealth>0){laser_deg=P_beam*dt_proper*LASER_DEGRADE_PER_JOULE;S.laserHealth=Math.max(0,S.laserHealth-laser_deg);}

    // Photon thrust from radiation
    const total_mass=DRY_MASS+Math.max(0,S.f);
    let Q_in=0,Q_out=0,Q_rad=0;
    if(regime<=5&&S.f>0&&Q_tot){Q_in=ALPHA*Q_tot;Q_rad=SIGMA_SB*EPS_RAD*A_RAD*(Math.pow(S.tB,4)-Math.pow(T_AMB,4));Q_out=Q_TE_total+md_abl*H_SUB+Q_rad;}
    else if(regime===6){Q_in=0.1*P_LIA_BACKUP;Q_out=Q_TE_total;}
    else{Q_in=0;Q_out=Q_TE_total;}
    const photon_thrust=Q_rad/C;
    thrust+=photon_thrust;

    // [FIX] Thermal & radiated energy: cumulative in coordinate time
    S.eTherm+=Q_in*dt;
    S.eRad+=Q_rad*dt;
    const C_th=total_mass*500;
    const dT=(Q_in-Q_out)/C_th*dt_proper;
    S.tB=Math.max(T_AMB,Math.min(T_MAX+5,S.tB+dT));

    // RK4 integration (Earth coordinate time)
    const net_thrust=thrust;
    const v_new=rk4Step(S.v,net_thrust,total_mass,dt);
    const v_euler=S.v+rk4Accel(S.v,net_thrust,total_mass)*dt;
    const rk_err=(v_new>0)?Math.abs(v_new-v_euler)/Math.max(1,v_new)*100:0;
    setT('eb_rkerr',rk_err<1e-6?'< 0.0001%':rk_err.toFixed(4)+'%');

    // Trapezoidal distance
    const v_clamped=Math.max(0,Math.min(v_new,0.99999*C));
    S.d+=(S.v+v_clamped)*0.5*dt;
    S.v=v_clamped;

    // Stop condition: braked successfully
    if(S.isBraking&&S.v<100&&remaining_m<AU_TO_M*0.01){
        S.v=0;S.targetReached=true;
        addLog(`🛑 Arrived. Ship stationary. Earth time: ${(S.tEarth/SEC_YR).toFixed(2)} yr, Ship time: ${(S.t/SEC_YR).toFixed(2)} yr.`);
        return;
    }
    // Overshoot warning: passed target while still fast (but don't stop sim)
    if(S.d > targetDist_m && !S.targetReached && S.v > 1000 && S.isBraking){
        addLog(`⚠️ FLYBY: Passed target at ${(S.v/C*100).toFixed(4)}%c. Braking insufficient for orbital insertion.`);
        // Don't set targetReached — let the sim continue so user can observe
    }

    S.t+=dt_proper; S.tEarth+=dt;

    // Kilopower drain
    let kilo_rate=0;
    if(regime===1)kilo_rate=1.0;
    else if(regime===6&&S.kiloLife>0&&P_te<P_LIA_BACKUP)kilo_rate=2.0;
    if(S.kiloLife>0)S.kiloLife=Math.max(0,S.kiloLife-(kilo_rate*dt_proper/SEC_YR));

    // Dimensionless groups
    const Pi1_val=(P_beam>0&&Q_tot>0)?Q_tot/P_beam:0;
    const Pi2_val=(mdot_tot>0&&Q_tot>0)?Q_tot/(mdot_tot*C*C):0;
    const Pi3_val=(Q_in>0)?Q_out/Q_in:0;
    const Pi4_val=(Q_tot>0)?P_te/Q_tot:0;
    const ism_disp=(regime===5||regime===6)?A_CATCH*S.v*RHO_ISM:0;
    const Pi6_val=(mdot_tot>0&&ism_disp>0)?ism_disp/mdot_tot:0;
    setT('Pi1',Pi1_val.toExponential(4));setT('Pi2',Pi2_val.toExponential(4));
    setT('Pi3',Pi3_val.toFixed(6));setT('Pi4',Pi4_val.toExponential(4));
    setT('Pi5',ablMu.toFixed(4));setT('Pi6',Pi6_val.toExponential(4));

    updateUI(P_te,P_beam,V_acc,ecm,net_thrust,th_ff,th_fus,th_pion,th_abl,md_ff,md_fus,md_pion,md_abl,mdot_tot,kilo_rate,regime,lih_used,laser_deg,ltd_used,brakeForce);
}

function updateUI(P_te,P_beam,V_acc,ecm,net_thrust,tFF,tFus,tPion,tAbl,mFF,mFus,mPion,mAbl,mdot_tot,kilo_rate,regime,lih_used,laser_deg,ltd_used,brakeForce){
    let dist_au=S.d/AU_TO_M;
    // Velocity: always %c with 18 decimal places
    setT('outVel', (S.v/C*100).toFixed(18) + ' %c');

    // Time: show full Y D HH:MM:SS for both clocks
    function fmtFullTime(s) {
